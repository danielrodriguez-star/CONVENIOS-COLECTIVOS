# Ejemplo de proxy inverso con HTTPS automático (Caddy 2). Sin probar en este entorno.
# Sustituye convenios.ejemplo.es por el nombre público que figura en CONVENIOS_HOSTS_PERMITIDOS.
convenios.ejemplo.es {
    encode zstd gzip
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:8000
}
