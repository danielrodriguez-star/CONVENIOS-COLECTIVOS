# Copiar a /etc/convenios/convenios.env y ajustar. Ver PRODUCCION.md, sección 5.
# Formato de systemd: VARIABLE=valor, sin comillas.

CONVENIOS_DATOS=/var/lib/convenios
CONVENIOS_ROBOTS=respetar
CONVENIOS_TLS_HEREDADO=portaldogc.gencat.cat,bop.dipucr.es
# Nombre público del panel (el que aparece en el navegador). Sustitúyelo por el tuyo.
CONVENIOS_HOSTS_PERMITIDOS=convenios.ejemplo.es
CONVENIOS_COPIAS_CONSERVAR=14
CONVENIOS_ALERTA_HORAS=72
CONVENIOS_PERMITIR_IFRAME=no
